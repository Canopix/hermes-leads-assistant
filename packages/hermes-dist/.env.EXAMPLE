# Hermes profile .env (reference — provision-client.sh writes this per client)
# Path: ~/.hermes/profiles/{slug}-leads/.env

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_ALL_USERS=true
MEM0_API_KEY=
MEM0_AGENT_ID={slug}-leads

# LLM (OpenAI-compatible; required for custom endpoints)
OPENAI_API_KEY=

# Embeddings for lead-rag (optional if same as OPENAI_API_KEY)
LEAD_EMBEDDING_API_KEY=
LEAD_EMBEDDING_BASE_URL=
LEAD_EMBEDDING_MODEL=

# Kapso WhatsApp (optional)
# KAPSO_API_KEY=
# KAPSO_PHONE_NUMBER_ID=
# KAPSO_PORT=
# KAPSO_WEBHOOK_SECRET=
# KAPSO_WEBHOOK_URL=
