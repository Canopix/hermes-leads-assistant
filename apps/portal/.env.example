# Portal (Next.js + Better Auth) — copy to apps/portal/.env

# ----- Required for auth -----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# Public URL of the portal. In dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of trusted origins for CORS / cookies (optional in dev).
# BETTER_AUTH_TRUSTED_ORIGINS=https://leads.example.com

# ----- Filesystem -----
# Absolute path to the Hermes profiles dir. Use $HOME (shell-expanded at read
# time) or an absolute path — do NOT use a bare `~`, Node's `path` module does
# not expand it. The portal normalizes a leading `~/` defensively, but other
# tools reading this env may not.
HERMES_PROFILES_DIR=$HOME/.hermes/profiles

# Optional: path to tenants.json for display names (legacy CLI mode).
# In the SaaS build the real tenant list lives in the portal auth DB.
# TENANTS_JSON=../../tenants.json

# Optional: override the auth DB location. Defaults to ~/.hermes/portal/auth.sqlite
# PORTAL_AUTH_DB=/var/lib/lead-ai/portal/auth.sqlite

# ----- Observability -----
# Pino log level. Defaults to "info" in prod, "debug" in dev.
# LOG_LEVEL=info

# Optional: Sentry DSN for error tracking. If unset, Sentry is a no-op.
# Get one at https://sentry.io — the @sentry/nextjs SDK must be installed.
# SENTRY_DSN=https://xxxxx@oNNNNNN.ingest.sentry.io/PROJECT_ID
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared secret that lets external watchdogs (Uptime Kuma, Healthchecks.io)
# call GET /api/health/tenants with header `X-Watchdog-Token: <value>`.
# Must be at least 16 chars. Generate with: openssl rand -hex 32
# Required only if you wire up external monitoring; the endpoint returns 503
# while unset.
# WATCHDOG_TOKEN=

# ----- Deprovisioning / backups -----
# Where encrypted tenant archives (tar.gz.enc) are written during
# deprovisioning. Default: ~/backups
# LEADAI_BACKUPS_DIR=/var/backups/lead-ai
