---
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
  <div class="container py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {/* Col 1: Logo */}
      <div class="space-y-4">
        <div class="flex items-center gap-2 font-semibold">
          <span class="flex h-8 w-8 items-center justify-center rounded-button bg-primary text-primary-foreground">
            <Icon name="sparkles" size={16} />
          </span>
          <span class="text-[15px] tracking-tight">Hermes Leads</span>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Un asistente de IA para concesionarias de autos.
        </p>
      </div>

      {/* Col 2: Producto */}
      <div class="space-y-3">
        <p class="text-sm font-semibold">Producto</p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="#como-funciona" class="transition-colors hover:text-foreground">Cómo funciona</a></li>
          <li><a href="#features" class="transition-colors hover:text-foreground">Funcionalidades</a></li>
          <li><a href="#faq" class="transition-colors hover:text-foreground">Preguntas</a></li>
          <li><a href="/demo" class="transition-colors hover:text-foreground">Pedir demo</a></li>
        </ul>
      </div>

      {/* Col 3: Contacto */}
      <div class="space-y-3">
        <p class="text-sm font-semibold">Contacto</p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="mailto:hola@hermesleads.com" class="transition-colors hover:text-foreground">hola@hermesleads.com</a></li>
          <li><a href="/demo" class="transition-colors hover:text-foreground">Agendar llamada</a></li>
        </ul>
      </div>

      {/* Col 4: Acceso */}
      <div class="space-y-3">
        <p class="text-sm font-semibold">Acceso</p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="https://app.hermesleads.com/login" class="transition-colors hover:text-foreground">Iniciar sesión</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-border pt-6">
      <div class="flex flex-col items-center justify-between gap-3 text-xs text-muted-foreground sm:flex-row">
        <p>&copy; {year} Hermes Leads. Todos los derechos reservados.</p>
        <p>Hecho para concesionarias que venden autos.</p>
      </div>
    </div>
  </div>
</footer>
