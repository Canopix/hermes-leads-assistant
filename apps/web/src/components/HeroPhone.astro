---
// Mockup de teléfono con conversación real de WhatsApp.
// Construido 100% en HTML/CSS — sin imágenes externas, sin JS.
// El "auto parcialmente visible" detrás del teléfono se sugiere con
// un fondo cinematográfico oscuro + silueta gradiente, no con una foto.

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Conversación realista. Cliente pregunta, bot (Hermes Leads) responde
// con datos del inventario y le saca la info del lead.
type Msg =
  | { kind: "in"; text: string; time: string }
  | { kind: "out"; text: string; time: string }
  | { kind: "car"; title: string; price: string; year: string; km: string };

const mensajes: Msg[] = [
  { kind: "in", text: "Hola, andan buscando un Corolla usado?", time: "21:47" },
  {
    kind: "out",
    text: "Hola Martín, sí. Tenemos 3 Corolla disponibles. ¿Buscás nafta o híbrido?",
    time: "21:47",
  },
  { kind: "in", text: "Nafta, modelo nuevo si puede ser", time: "21:48" },
  {
    kind: "car",
    title: "Toyota Corolla XEI",
    price: "USD 21.900",
    year: "2023",
    km: "18.500 km",
  },
  {
    kind: "out",
    text: "Este es el más nuevo que tenemos. ¿Lo estás viendo para fin de mes o tenés tiempo?",
    time: "21:48",
  },
  { kind: "in", text: "Este mes, sí. Lo puedo ver el sábado?", time: "21:49" },
  {
    kind: "out",
    text: "Perfecto. Te agendo para el sábado a las 11. ¿Te contacto al 11-5555-1234?",
    time: "21:49",
  },
];
---

<div class={`relative ${className}`}>
  {/* Fondo cinematográfico: auto parcial + luz.
      NO usamos foto — usamos gradientes que sugieren el volumen
      de un auto iluminado, sin romper el "no ilustraciones AI". */}
  <div
    class="absolute inset-0 -z-10 overflow-hidden rounded-3xl"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-primary-dark via-foreground to-black"
    >
    </div>
    <div
      class="absolute -bottom-1/3 left-1/2 h-2/3 w-[140%] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(closest-side,hsl(221_83%_60%_/_0.35),transparent)] blur-2xl"
    >
    </div>
    {/* Silueta muy sutil de techo de auto — curva de gradiente */}
    <div
      class="absolute bottom-0 left-0 right-0 h-1/3 bg-[radial-gradient(120%_100%_at_50%_100%,hsl(222_18%_11%_/_0.9)_0%,transparent_70%)]"
    >
    </div>
  </div>

  {/* Teléfono enorme */}
  <div
    class="relative mx-auto aspect-[9/18.5] w-full max-w-[320px] rounded-[2.75rem] border-[10px] border-black bg-black shadow-2xl ring-1 ring-white/10 sm:max-w-[340px]"
  >
    {/* Notch */}
    <div
      class="absolute left-1/2 top-0 z-20 h-6 w-32 -translate-x-1/2 rounded-b-2xl bg-black"
    >
    </div>

    {/* Pantalla */}
    <div class="relative flex h-full w-full flex-col overflow-hidden rounded-[2rem] bg-[#0b141a]">
      {/* Status bar */}
      <div class="flex items-center justify-between px-6 pt-3 pb-1 text-[11px] font-medium text-white/90">
        <span>21:49</span>
        <div class="flex items-center gap-1">
          <span class="inline-block h-2.5 w-3.5 rounded-[2px] bg-white/80"></span>
          <span class="inline-block h-2.5 w-4 rounded-[2px] bg-white/60"></span>
        </div>
      </div>

      {/* Header del chat */}
      <div class="flex items-center gap-3 border-b border-white/5 bg-[#1f2c34] px-4 py-2.5">
        <span class="text-white/60 text-lg leading-none">‹</span>
        <div class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-primary text-[11px] font-bold text-primary-foreground">
          HL
        </div>
        <div class="flex-1 leading-tight">
          <p class="text-[13px] font-semibold text-white">Hermes Leads</p>
          <p class="text-[10px] text-[#25d366]">en línea</p>
        </div>
        <span class="text-white/50 text-base">⋮</span>
      </div>

      {/* Conversación */}
      <div class="flex-1 space-y-2 overflow-hidden px-3 py-3">
        {mensajes.map((m) => {
          if (m.kind === "car") {
            return (
              <div class="flex justify-end">
                <div class="w-[78%] overflow-hidden rounded-lg rounded-tr-sm bg-[#005c4b] shadow-sm">
                  <div class="flex items-center gap-3 bg-black/15 px-3 py-2.5">
                    <div class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-white/10 text-white/70">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.6c-.2.4-.2.8-.2 1.2V16c0 .6.4 1 1 1h2"/>
                        <circle cx="7" cy="17" r="2"/>
                        <path d="M9 17h6"/>
                        <circle cx="17" cy="17" r="2"/>
                      </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-[12px] font-semibold text-white">{m.title}</p>
                      <p class="text-[10px] text-white/70">{m.year} · {m.km}</p>
                    </div>
                    <p class="flex-none text-[12px] font-bold text-[#25d366]">{m.price}</p>
                  </div>
                  <div class="px-3 py-1.5 text-[10px] text-white/50">Catálogo · Hermes Leads</div>
                </div>
              </div>
            );
          }

          const isIn = m.kind === "in";
          return (
            <div class={`flex ${isIn ? "justify-start" : "justify-end"}`}>
              <div
                class={`relative max-w-[78%] rounded-lg px-2.5 py-1.5 text-[12px] leading-snug shadow-sm ${
                  isIn
                    ? "rounded-tl-sm bg-[#1f2c34] text-white"
                    : "rounded-tr-sm bg-[#005c4b] text-white"
                }`}
              >
                <span>{m.text}</span>
                <span class="ml-1.5 inline-block translate-y-[1px] text-[9px] text-white/50">
                  {m.time}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      {/* Input bar */}
      <div class="flex items-center gap-2 border-t border-white/5 bg-[#1f2c34] px-3 py-2">
        <div class="flex-1 rounded-full bg-[#2a3942] px-3 py-1.5 text-[11px] text-white/40">
          Mensaje
        </div>
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#2a3942] text-white/60">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
