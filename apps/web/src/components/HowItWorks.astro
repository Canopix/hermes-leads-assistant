---
import Icon from "./Icon.astro";

const pasos = [
  {
    n: "1",
    titulo: "Conectamos el asistente",
    desc: "Nos pasás el WhatsApp Business o el Telegram donde te escriben hoy. En minutos está respondiendo con tu marca.",
    icon: "message-circle" as const,
  },
  {
    n: "2",
    titulo: "Lo entrenamos con tu stock",
    desc: "Cargás tu inventario y nos contás qué datos necesitás de cada interesado. El asistente aprende cómo trabajás.",
    icon: "brain" as const,
  },
  {
    n: "3",
    titulo: "Recibís oportunidades",
    desc: "Cada conversación aparece clasificada en el portal. Entrás y llamás al más listo primero.",
    icon: "target" as const,
  },
];
---

<section id="como-funciona" class="border-b border-border bg-background">
  <div class="container py-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">
        Cómo funciona
      </p>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">
        Empezás a recibir oportunidades en tres pasos
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        Sin tocar código. Sin contratar un técnico. Nosotros armamos el setup.
      </p>
    </div>

    <div class="mt-16 flex flex-col gap-6 lg:flex-row lg:items-stretch">
      {pasos.map((p, i) => (
        <div class="flex flex-1 items-stretch gap-6">
          <div class="flex-1 rounded-card border border-border bg-background p-8">
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-button bg-primary text-primary-foreground">
                <Icon name={p.icon} size={22} />
              </div>
              <span class="text-4xl font-extrabold text-muted-foreground/30">{p.n}</span>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.desc}</p>
          </div>
          {i < pasos.length - 1 && (
            <div class="hidden items-center justify-center lg:flex">
              <Icon name="arrow-right" size={28} class="text-border" />
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="mt-12 mx-auto max-w-3xl rounded-button border border-border bg-background px-8 py-6 text-center">
      <p class="text-sm text-muted-foreground">
        Setup típico:
        <span class="ml-1 font-semibold text-foreground">menos de 48 horas</span>.
        Te lo dejamos funcionando.
      </p>
    </div>
  </div>
</section>
