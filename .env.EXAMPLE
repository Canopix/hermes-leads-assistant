# Hermes Leads Assistant — monorepo environment (operator / deploy)

# Path to Hermes profiles (used by portal and ops scripts)
HERMES_PROFILES_DIR=~/.hermes/profiles

# Portal secrets — prefer apps/portal/.env for local dev
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here
# BETTER_AUTH_SECRET=your-better-auth-secret-here

# Bot credentials belong in ~/.hermes/profiles/{slug}-leads/.env
# See packages/hermes-dist/.env.EXAMPLE for reference
